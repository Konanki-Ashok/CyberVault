# TrustVault Environment Configuration Example (Placeholders Only)
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://mongo:27017/trustvault

# JWT Secrets (Generate secure random 32+ character strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Signing Secret
COOKIE_SECRET=your_cookie_signing_secret_key_minimum_32_characters_here

# Frontend Application Origin
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API base URL (set to the public backend URL when deployed separately)
VITE_API_URL=http://localhost:5000/api

# Storage Configuration ('local' or 's3')
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/uploads

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Optional AI Service (Gemini / LLM)
AI_SERVICE_ENABLED=false
AI_API_KEY=your_gemini_or_llm_api_key_here

# Firebase Admin SDK (backend) — optional; leave blank for dev demo mode
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Firebase Client SDK (frontend) — set these in frontend/.env
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:xxx:web:xxx
